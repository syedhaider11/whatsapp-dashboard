# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/waba_portal?schema=public"

# Auth.js / session signing (generate a 32-byte random string)
AUTH_SESSION_SECRET=""

# Seed admin account (used by `npm run db:seed`)
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ChromaDB RAG service
CHROMA_URL="http://localhost:8000"

# Embedding + LLM provider
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
CHROMA_COLLECTION="waba_documents"

# Meta WhatsApp Cloud API — webhook verification
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Optional — defaults to v20.0 when unset.
META_GRAPH_VERSION="v20.0"
# Note: Phone Number ID, WABA ID and the permanent access token are entered
# on the dashboard WhatsApp page and stored in the database, not here.
#
# The keys below are documented only — the app does NOT read them from env.
# They are listed so the full Meta set is discoverable; enter the values on the
# WhatsApp dashboard page instead.
# META_APP_ID=""
# META_WABA_ID=""
# META_PHONE_NUMBER_ID=""
# META_ACCESS_TOKEN=""
#
# See META_SETUP.md for the full onboarding guide.
