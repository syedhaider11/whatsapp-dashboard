generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  LOCATION
}

enum DocumentStatus {
  PENDING
  VALIDATING
  STORING
  EXTRACTING
  EMBEDDING
  INDEXING
  READY
  FAILED
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MESSAGE
  CONNECTION
  API_ERROR
  USER
  SYSTEM
}

model Profile {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents             Document[]        @relation("DocumentUploader")
  activityLogs          ActivityLog[]
  notifications         Notification[]
  assignedConversations Conversation[]    @relation("ConversationAssignee")
  assignedContacts      Contact[]         @relation("ContactAssignee")
  messagesSent          Message[]         @relation("MessageSender")
  templatesCreated      MessageTemplate[] @relation("TemplateCreator")
  whatsappAccounts      WhatsAppAccount[] @relation("WhatsAppConnectedBy")

  @@map("profiles")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  label       String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles        Profile[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  label String
  group String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model WhatsAppAccount {
  id              String         @id @default(cuid())
  name            String
  phoneNumber     String
  phoneNumberId   String         @unique
  wabaId          String
  accessToken     String
  status          WhatsAppStatus @default(DISCONNECTED)
  qualityRating   String?
  messagingTier   String?
  webhookUrl      String?
  processedEvents Int            @default(0)
  lastError       String?
  isActive        Boolean        @default(false)
  connectedById   String?
  connectedBy     Profile?       @relation("WhatsAppConnectedBy", fields: [connectedById], references: [id])
  connectedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  conversations Conversation[]

  @@map("whatsapp_accounts")
}

model Contact {
  id                String    @id @default(cuid())
  name              String
  phoneNumber       String    @unique
  email             String?
  tags              String[]  @default([])
  notes             String?
  assignedToId      String?
  assignedTo        Profile?  @relation("ContactAssignee", fields: [assignedToId], references: [id])
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversations Conversation[]

  @@index([assignedToId])
  @@map("contacts")
}

model Conversation {
  id                String             @id @default(cuid())
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount    @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        Profile?           @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  status            ConversationStatus @default(OPEN)
  unreadCount       Int                @default(0)
  lastMessageAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  messages Message[]

  @@index([contactId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  status         MessageStatus    @default(QUEUED)
  type           MessageType      @default(TEXT)
  body           String?
  mediaUrl       String?
  mediaMimeType  String?
  waMessageId    String?          @unique
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])
  sentById       String?
  sentBy         Profile?         @relation("MessageSender", fields: [sentById], references: [id])
  errorMessage   String?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Document {
  id           String         @id @default(cuid())
  fileName     String
  filePath     String
  fileSize     Int
  fileType     String
  status       DocumentStatus @default(PENDING)
  pageCount    Int?
  chunkCount   Int            @default(0)
  collectionId String?
  error        String?
  uploadedById String
  uploadedBy   Profile        @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@map("documents")
}

model MessageTemplate {
  id             String         @id @default(cuid())
  name           String         @unique
  body           String
  language       String         @default("en_US")
  category       String?
  status         TemplateStatus @default(DRAFT)
  variables      String[]       @default([])
  metaTemplateId String?
  createdById    String?
  createdBy      Profile?       @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages Message[]

  @@index([status])
  @@map("message_templates")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
